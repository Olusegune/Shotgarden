{
  "name": "shotgarden",
  "description": "A local-first AI image and video studio for Windows.",
  "author": "Olusegune",
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "models": "node scripts/sync-models.mjs",
    "registry:build": "node scripts/sync-models.mjs && shadcn build",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "pnpm build && pnpm desktop:prepare && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.3",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "mongodb": "^7.7.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "stripe": "^23.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.shotgarden.desktop",
    "productName": "Shotgarden",
    "asar": true,
    "directories": { "output": "desktop-dist" },
    "files": ["electron/**/*", "package.json"],
    "extraResources": [
      { "from": "desktop-runtime", "to": "desktop-runtime" },
      {
        "from": "electron/assets/shotgarden-project.ico",
        "to": "shotgarden-project.ico"
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "electron/assets/shotgarden.ico",
      "artifactName": "Shotgarden-${version}-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "shotgarden",
        "name": "Shotgarden Project",
        "description": "Shotgarden creative project",
        "icon": "electron/assets/shotgarden-project.ico",
        "role": "Editor"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
